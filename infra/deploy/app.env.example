# Build settings for a deployed modelXare app. On Vercel, add each one under
# Project → Settings → Environment Variables; locally, `set -a; . ./app.env; set +a`
# before `pnpm --filter @wexare/simple build`. The build checks them and stops
# with a list of problems if one is wrong. Example values: weXare's deployment.

# Relays the app reads releases from (wss://, comma-separated). Required.
# Public Nostr relays to start with; add your own later (e.g. wss://relay.wexare.com)
# and send the existing releases to it too (docs/deployment.md, "Add your own relay").
WEXARE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# IPFS gateways, tried in order (https://), for files published with ipfs:// locations.
# None needed while every file is on Hugging Face.
# WEXARE_IPFS_GATEWAYS=https://ipfs.wexare.com,https://ipfs.io

# WebTorrent trackers (wss://). Leave unset for no torrent downloads.
# WEXARE_TRACKERS=

# Arweave gateways, for ar:// file locations (https://).
WEXARE_ARWEAVE_GATEWAYS=https://arweave.net

# Where a new publisher asks to be approved (https:// or mailto:), shown on the Xare page.
# WEXARE_APPROVAL_REQUEST=

# Approved publishers file, relative to the repository root.
# WEXARE_PUBLISHERS=infra/publishers.json
