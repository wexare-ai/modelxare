# The server's public names. Copy to .env next to docker-compose.yml and point
# each name's DNS (A/AAAA record) at this server before `docker compose up -d`.
# Example values: weXare's deployment.
RELAY_DOMAIN=relay.wexare.com
IPFS_DOMAIN=ipfs.wexare.com
MODELS_DOMAIN=models.wexare.com

# What the relay says about itself (NIP-11).
RELAY_NAME=modelXare relay
RELAY_CONTACT=
# Events one address may send per minute.
RELAY_EVENTS_PER_MINUTE=30

# Where uploaded mirror files live on this server.
MODELS_DIR=./models

# 1: join the public IPFS network (production). 0: stay isolated (trying it out).
IPFS_PUBLIC=1
