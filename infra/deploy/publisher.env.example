# Settings for publishing with `pnpm cli release …` to a deployment. Load them
# with `set -a; . ./publisher.env; set +a` from the repository root. Once any is
# set, the CLI never falls back to the local development services, so a public
# release can't point at this machine. Example values: weXare's deployment.

# Relays `release publish` sends to (wss://, comma-separated): the same as the app's.
WEXARE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# Only once you run your own server (docs/deployment.md, "Add your own server"):
# The mirror's address, for releases whose definition lists "mirror" or
# "torrent" locations. Files wait in WEXARE_MIRROR_ROOT until you upload that
# folder's sha256/ and torrents/ to <mirror>/main/.
# WEXARE_MIRROR_URL=https://models.wexare.com
# WEXARE_MIRROR_ROOT=.data/deploy-mirror
# Kubo RPC API, for "ipfs" locations. The server's never has a public port:
# reach it with `ssh -N -L 5101:127.0.0.1:5001 <server>` (5101 here, because a
# local development node may already use 5001).
# WEXARE_IPFS_API=http://127.0.0.1:5101

# WebTorrent trackers (wss://), for "torrent" locations.
# WEXARE_TRACKERS=
