{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wexare:schema:micromodel-release:0.1",
  "title": "weXare micro-model release manifest 0.1",
  "description": "Experimental weXare application profile. The exact UTF-8 manifest string is embedded in a NIP-94 kind:1063 event (tag `wexare-manifest`) and hashed in its `x` tag. A manifest never contains its own event ID or hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "name", "description", "version", "kind", "capabilities", "languages", "license", "runtime", "files", "operations", "requirements"],
  "properties": {
    "schema": { "const": "wexare.micromodel.release/0.1" },
    "model_id": {
      "description": "Stable publisher-local slug. A model family is publisher pubkey + model_id.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": {
      "description": "Strict semantic version (semver.org 2.0.0).",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "kind": { "enum": ["model", "lora"] },
    "capabilities": {
      "description": "Operation IDs this release claims to support.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "languages": {
      "description": "BCP 47 language identifiers; `und` when unknown.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:und|[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$" }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "description": "Declared identifier, SPDX where possible.", "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "$ref": "#/$defs/webUrl" },
        "attribution": { "type": "string", "maxLength": 500 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "family", "requirement", "browser_features"],
      "properties": {
        "format": { "description": "Artifact format, e.g. `gguf`.", "$ref": "#/$defs/slug" },
        "family": { "description": "Runtime family, e.g. `wllama`. Clients must treat unknown families as unsupported.", "$ref": "#/$defs/slug" },
        "requirement": { "description": "Runtime compatibility requirement, e.g. a semver range of the runtime family.", "type": "string", "minLength": 1, "maxLength": 100 },
        "browser_features": {
          "description": "Browser features required to execute, e.g. `wasm`, `wasm-simd`, `webgpu`.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "chat_template": {
          "description": "Chat template to use: the one embedded in the GGUF file, an inline Jinja template, or none for completion-only models.",
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "enum": ["embedded", "none"] } } },
            { "type": "object", "additionalProperties": false, "required": ["source", "template"], "properties": { "source": { "const": "inline" }, "template": { "type": "string", "minLength": 1, "maxLength": 8000 } } }
          ]
        }
      }
    },
    "files": {
      "description": "Ordered required files.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/file" }
    },
    "operations": {
      "description": "Executable configuration for bundled operation IDs. Each id must also appear in capabilities.",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/operation" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_length"],
      "properties": {
        "context_length": { "description": "Context length the publisher configured and tested.", "type": "integer", "minimum": 1, "maximum": 1048576 },
        "memory_mb": {
          "description": "Reported resident memory. Absent means unknown, never 'fits'.",
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "basis", "context_length"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "basis": { "enum": ["measured", "estimated"] },
            "context_length": { "type": "integer", "minimum": 1 },
            "notes": { "type": "string", "maxLength": 500 }
          }
        },
        "hardware_profiles": {
          "description": "Reported hardware profiles, e.g. `cpu-wasm`, `webgpu`.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "base": {
      "description": "LoRA only: the exact base release this adapter applies to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256", "files"],
      "properties": {
        "release_id": { "description": "Nostr event ID of the base release.", "$ref": "#/$defs/hex64" },
        "manifest_sha256": { "$ref": "#/$defs/hex64" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "size"],
            "properties": { "sha256": { "$ref": "#/$defs/hex64" }, "size": { "$ref": "#/$defs/byteCount" } }
          }
        }
      }
    },
    "labels": {
      "description": "Free-form labels. `synthetic` marks generated non-runnable test records.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "lora" } } },
      "then": { "required": ["base"] },
      "else": { "not": { "required": ["base"] } }
    }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 64 },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "byteCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "webUrl": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "size", "sha256", "locations"],
      "properties": {
        "role": { "enum": ["weights", "adapter", "tokenizer", "config"] },
        "path": {
          "description": "Logical relative path; no traversal segments.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*/\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "size": { "$ref": "#/$defs/byteCount" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "locations": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/location" } }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "uri"],
      "properties": {
        "transport": { "description": "Protocol 0.1 recognizes ipfs, https, http (loopback, development only), torrent and arweave. Clients ignore unknown transports.", "$ref": "#/$defs/slug" },
        "uri": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "path": { "description": "Torrent only: exact file path inside the torrent.", "type": "string", "minLength": 1, "maxLength": 400 }
      },
      "allOf": [
        { "if": { "properties": { "transport": { "const": "ipfs" } } }, "then": { "properties": { "uri": { "type": "string", "pattern": "^ipfs://[A-Za-z0-9]{46,100}(?:/[^\\s]*)?$" } } } },
        { "if": { "properties": { "transport": { "const": "https" } } }, "then": { "properties": { "uri": { "type": "string", "pattern": "^https://[^\\s]+$" } } } },
        { "if": { "properties": { "transport": { "const": "http" } } }, "then": { "properties": { "uri": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d{1,5})?/[^\\s]*$" } } } },
        { "if": { "properties": { "transport": { "const": "torrent" } } }, "then": { "required": ["path"], "properties": { "uri": { "type": "string", "pattern": "^magnet:\\?[^\\s]*xt=urn:btih:[0-9a-fA-F]{40}[^\\s]*$" } } } },
        { "if": { "properties": { "transport": { "const": "arweave" } } }, "then": { "properties": { "uri": { "type": "string", "pattern": "^ar://[A-Za-z0-9_-]{43}(?:/[^\\s]*)?$" } } } }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "input_schema", "output_schema"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "prompt": {
          "description": "Prompt text only. {{input}}, {{categories}} and {{language}} placeholders are substituted as plain text by the client.",
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "template"],
          "properties": {
            "mode": { "enum": ["chat", "completion"] },
            "system": { "type": "string", "maxLength": 4000 },
            "template": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 1, "maximum": 2048 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "top_k": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
            "stop": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        },
        "routing": {
          "description": "What requests this model is the one for, in a few words (\"git commands: commits, branches and history\"). The System 1 router reads it to choose between models that do the same operation.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" }
      }
    }
  }
}
