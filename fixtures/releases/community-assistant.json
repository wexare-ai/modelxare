{
  "fixture": "qwen2.5-0.5b-instruct-q4_k_m",
  "publisher": "publisher-a",
  "manifest": {
    "model_id": "community-assistant",
    "name": "Community message assistant (Qwen2.5 0.5B Q4_K_M)",
    "description": "Classifies community messages into a small issue category set and writes one-sentence summaries. English and Spanish.",
    "version": "1.0.0",
    "kind": "model",
    "capabilities": [
      "text-classification",
      "summarization"
    ],
    "languages": [
      "en",
      "es"
    ],
    "runtime": {
      "format": "gguf",
      "family": "wllama",
      "requirement": ">=3.8.1 <3.9.0",
      "browser_features": [
        "wasm-simd"
      ],
      "chat_template": {
        "source": "embedded"
      }
    },
    "operations": [
      {
        "id": "text-classification",
        "prompt": {
          "mode": "chat",
          "system": "You classify messages written by residents of a building or neighborhood. Answer with exactly one category from this list: {{categories}}.",
          "template": "Message: {{input}}"
        },
        "generation": {
          "max_tokens": 8,
          "temperature": 0
        }
      },
      {
        "id": "summarization",
        "prompt": {
          "mode": "chat",
          "system": "You summarize a resident's message in one short sentence written in {{language}}. Keep the key facts. Do not add anything.",
          "template": "{{input}}"
        },
        "generation": {
          "max_tokens": 60,
          "temperature": 0
        }
      }
    ],
    "requirements": {
      "context_length": 1024,
      "memory_mb": {
        "value": 700,
        "basis": "estimated",
        "context_length": 1024,
        "notes": "file size + KV cache + compute buffers, CPU/WASM"
      },
      "hardware_profiles": [
        "cpu-wasm"
      ]
    }
  },
  "locations": [
    "mirror",
    "ipfs",
    "torrent"
  ]
}
