{
  "manifest": {
    "model_id": "my-summarizer",
    "name": "My summarizer",
    "description": "Writes a one-sentence summary of a short message.",
    "version": "1.0.0",
    "kind": "model",
    "capabilities": ["summarization"],
    "languages": ["en"],
    "license": { "id": "Apache-2.0" },
    "runtime": {
      "format": "gguf",
      "family": "wllama",
      "requirement": ">=3.8.1 <3.9.0",
      "browser_features": ["wasm-simd"],
      "chat_template": { "source": "embedded" }
    },
    "operations": [
      {
        "id": "summarization",
        "prompt": {
          "mode": "chat",
          "system": "You summarize messages in one short sentence. Keep the key facts. Do not add anything.",
          "template": "Summarize this message in one short sentence:\n\n{{input}}"
        },
        "generation": { "max_tokens": 60, "temperature": 0, "stop": ["\n"] }
      }
    ],
    "requirements": { "context_length": 1024, "hardware_profiles": ["cpu-wasm"] }
  },
  "files": [
    {
      "role": "weights",
      "path": "model.gguf",
      "source": "./model.gguf",
      "urls": ["https://huggingface.co/YOUR-NAME/YOUR-MODEL/resolve/COMMIT/model.gguf"]
    }
  ]
}
